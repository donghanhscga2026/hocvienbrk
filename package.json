    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@getbrevo/brevo": "^6.2.0",
    "@hookform/resolvers": "^6.0.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.118.0",
    "@xyflow/react": "^12.12.0",
    "acorn": "8.19.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.3.1",
    "dotenv": "^18.0.8",
    "googleapis": "^171.4.0",
    "libphonenumber-js": "^1.13.15",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "parse5": "7.3.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-importer": "npm:tailwindcss@3.4.19",
    "uuid": "^14.0.3",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "overrides": {
    "next-auth": {
      "next": "$next"
    },
    "postcss-selector-parser": "^7.1.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "d3-hierarchy": "^3.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^26.1.0",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
