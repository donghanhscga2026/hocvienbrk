{
  "name": "brk-academy",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/generate-wi300-page-inventory.cjs",
    "build": "next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test:crm-notifications": "node scripts/test-crm-notifications.cjs",
    "test:website-templates": "node scripts/test-free-design-disabled.cjs",
    "test:custom-domains": "node scripts/test-custom-domains.cjs",
    "test:multisite-integration": "node scripts/test-multisite-integration.cjs",
    "test:website-cleanup": "node scripts/test-website-cleanup.cjs",
    "process-legacy": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/process-legacy-users.ts",
    "fill-missing": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/fill-missing-ids.ts",
    "change-id": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/change-id.ts",
    "add-reserved": "ts-node --compiler-options {\"module\":\"CommonJS\"} scripts/add-reserved-id.ts",
    "code-history": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/generate-code-history.ts",
    "create-brk-profile": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/create-brk-profile.ts",
    "add-site-profiles-tool": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/add-site-profiles-tool.ts",
    "migrate-external-images": "ts-node -P tsconfig.seed.json scripts/migrate-external-images-to-supabase.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
