    "dotenv": "^17.3.1",
    "googleapis": "^171.4.0",
    "libphonenumber-js": "^1.13.7",
    "lightningcss": "^1.32.0",
    "lucide-react": "^0.570.0",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.25",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
