# Server-only values: add in Vercel Settings > Environment Variables, then redeploy.
# Use a separate bucket/token/domain for Preview. Never prefix secrets with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public read domain connected to the bucket, for example https://images.your-domain.vn
# Use a custom domain for production; the r2.dev development URL is rate-limited.
R2_PUBLIC_BASE_URL=
